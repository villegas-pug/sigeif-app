		<band height="634" splitType="Stretch">
			<element kind="staticText" uuid="a6a6ff38-1f32-47de-90c1-7b2ae227eaf5" x="7" y="420" width="535" height="35" fontName="Arial" fontSize="11.0" hTextAlign="Justified">
				<text><![CDATA[Lugar y fecha:]]></text>
				<box topPadding="10" leftPadding="10" bottomPadding="10" rightPadding="10">
